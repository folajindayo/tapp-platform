# Tapp Merchant — example environment configuration.
# Copy to .env and fill in real values. .env is gitignored.
#
# For production builds, set the same values in app.json under
# expo.extra.* so they bake into the binary instead of relying on
# dev-server env injection.

# Rails backend URL. localhost won't work on a physical device tethered
# over LAN — use your laptop's LAN IP (same Wi-Fi as the device):
#   ipconfig getifaddr en0        # macOS
#   ip addr show wlan0            # Linux
EXPO_PUBLIC_API_BASE_URL=https://reggie-undefinable-cash.ngrok-free.dev/v1

# Payer-side checkout web app. The merchant phone embeds this URL in
# the NDEF broadcast (Android HCE) or QR code (iOS) — payer's phone
# opens it via the OS NDEF / QR handler.
EXPO_PUBLIC_CHECKOUT_BASE_URL=https://checkout.zoracle.com
