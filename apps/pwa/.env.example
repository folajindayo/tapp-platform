# ============================================================================
# Tapp PWA — environment
#
# Every variable the app reads is listed here, with no value filled in.
# NEXT_PUBLIC_ variables are compiled into the browser bundle and are readable
# by anyone who opens the site; everything else is server-only and must stay
# that way. An earlier revision shipped a provider RPC key to every visitor by
# putting it behind a NEXT_PUBLIC_ name.
# ============================================================================

# ---------------------------------------------------------------- the API

# Where the API lives, e.g. https://api.example.com — no trailing slash.
#
# REQUIRED. There is no default. A build without it used to fall back to
# http://localhost:8000, which shipped a bundle whose every request went to a
# machine the user does not have; the failure then read as "the network is
# down" rather than "this was built without an API URL".
NEXT_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------- the map

# Tile URL template for the agents map, with {z}/{x}/{y} placeholders and
# optionally {s} for subdomain rotation. There is deliberately no default: a
# tile URL is a provider's terms, rate limit and bill, and choosing one in the
# bundle decides that on your behalf. With this unset the map says so in place
# of the tiles and the nearby list still works.
NEXT_PUBLIC_MAP_TILE_URL=

# Comma-separated subdomains for {s}, if your provider uses them, e.g. a,b,c
NEXT_PUBLIC_MAP_TILE_SUBDOMAINS=

# The credit your tile provider requires, shown on the map. Most require one.
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Highest zoom your provider serves. Defaults to 19 when unset.
NEXT_PUBLIC_MAP_MAX_ZOOM=

# ---------------------------------------------------------------- server-only

# Admin token for the card-issuing route (app/api/cards/issue). Never
# NEXT_PUBLIC_: it authorises issuing physical cards.
ADMIN_API_TOKEN=
